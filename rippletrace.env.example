# ============================================================
#  涟漪 RippleTrace AI 配置示例
#
#  用法：把本文件复制为 rippletrace.env，填入自己的密钥即可。
#      copy rippletrace.env.example rippletrace.env
#
#  为什么用文件而不是环境变量：
#    环境变量只在「启动服务的那一个终端」里有效，换个窗口、
#    或者用资源管理器双击启动，配置就丢了。rippletrace.env 放在
#    项目目录里，任何方式启动都能读到。
#
#  优先级：真实的环境变量 > rippletrace.env > .env
#    所以临时用另一个 key 跑一次，只要在命令行里设一下就能覆盖，
#    不必改这个文件。
#
#  安全：密钥只由服务进程读取，绝不会出现在
#    - 浏览器请求或网页源码中
#    - 命令行参数中（helper 子进程通过 stdin 接收）
#    请不要把 rippletrace.env 提交到版本库。
# ============================================================

# 必填。没有它 AI 解释层保持关闭，其余功能不受影响。
RIPPLETRACE_AI_KEY=

# 可选。任何 OpenAI 兼容的 chat/completions 接口都可以。
# 留空则使用下面的默认值。
#RIPPLETRACE_AI_ENDPOINT=https://api.deepseek.com/v1/chat/completions

# 可选。默认 deepseek-chat。
#RIPPLETRACE_AI_MODEL=deepseek-chat

# 可选。模型写「核查什么」「为什么」这两栏用的语言。
#   zh   = 简体中文（默认）
#   en   = English
#   auto = 跟随提问语言
# 函数名、文件路径、代码标识符在任何模式下都保持原样，不会被翻译。
# 填了无法识别的值会回落到 zh，而不是报错。
#RIPPLETRACE_AI_LANG=zh

# 可选。回退传输用的解释器与脚本，用于本机原生 TLS 不可用的情况
# （症状是 WinHTTP 报 12185）。一般不需要设置。
#RIPPLETRACE_AI_HELPER=python
#RIPPLETRACE_AI_HELPER_SCRIPT=tools/llm_transport.py
